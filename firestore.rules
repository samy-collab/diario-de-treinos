rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      // A seguranca real fica no servidor: esconder dados na tela nao basta.
      return request.auth != null && request.auth.uid == userId;
    }

    function validWorkout() {
      // Repete no servidor as regras essenciais aplicadas pelo formulario.
      return request.resource.data.keys().hasAll([
          'activity', 'date', 'durationMinutes', 'distanceKm',
          'loadKg', 'intensity', 'notes'
        ])
        && request.resource.data.activity in ['Caminhada', 'Corrida', 'Ciclismo', 'Musculação', 'Natação', 'Outro']
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.durationMinutes is number
        && request.resource.data.durationMinutes > 0
        && request.resource.data.distanceKm is number
        && request.resource.data.distanceKm >= 0
        && request.resource.data.loadKg is number
        && request.resource.data.loadKg >= 0
        && request.resource.data.intensity in ['Leve', 'Moderada', 'Intensa']
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 300;
    }

    function validProfile() {
      return request.resource.data.keys().hasAll(['name', 'age', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'age', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.age is int
        && request.resource.data.age >= 1
        && request.resource.data.age <= 120;
    }

    match /users/{userId} {
      // Cada conta pode ler e gravar somente o proprio perfil.
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validProfile();
      allow delete: if false;

      match /workouts/{workoutId} {
        // O uid da sessao precisa coincidir com o uid existente no caminho.
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validWorkout();
      }
    }
  }
}
